# FinMind API (免費註冊: https://finmindtrade.com/)
FINMIND_TOKEN=your_finmind_token_here

# Telegram Bot (找 @BotFather 建立)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Google Sheet
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Google Service Account JSON (整串壓成一行)
GOOGLE_CREDS_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Gemini Vision（截圖解析）
GEMINI_API_KEY=your_gemini_api_key_here

# 總資金（曝險水位與集中度的分母，單位：元）
TOTAL_CAPITAL=200000

# 本人帳戶標記（截圖 sync 驗證，逗號分隔：戶名,帳號）；未設定則 sync 一律降級為純健檢
OWNER_MARKERS=你的戶名,你的帳號
